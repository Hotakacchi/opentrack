<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>            <string>com.opentrack.agent</string>
    <key>CFBundleName</key>                  <string>OpenTrack</string>
    <key>CFBundleDisplayName</key>           <string>OpenTrack</string>
    <key>CFBundleExecutable</key>            <string>OpenTrack</string>
    <key>CFBundlePackageType</key>           <string>APPL</string>
    <key>CFBundleShortVersionString</key>    <string>__VERSION__</string>
    <key>CFBundleVersion</key>               <string>__VERSION__</string>
    <key>LSMinimumSystemVersion</key>        <string>12.0</string>
    <!-- background app: no Dock icon, no menu bar -->
    <key>LSUIElement</key>                   <true/>
    <key>NSPrincipalClass</key>              <string>NSApplication</string>
    <key>NSLocationUsageDescription</key>
    <string>OpenTrack reports this Mac's location to your own dashboard so you can find it if it is lost or stolen.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>OpenTrack reports this Mac's location to your own dashboard so you can find it if it is lost or stolen.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>OpenTrack reports this Mac's location to your own dashboard so you can find it if it is lost or stolen.</string>
    <key>NSCameraUsageDescription</key>
    <string>When you switch this Mac to lost mode, OpenTrack takes one photo to help you recover it.</string>
</dict>
</plist>
